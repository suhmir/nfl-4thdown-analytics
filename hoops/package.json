{
  "name": "hardwood-heat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:mechanics && npm run test:sim",
    "test:mechanics": "esbuild scripts/usertest.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/hoops/usertest.cjs && node node_modules/.cache/hoops/usertest.cjs",
    "test:sim": "esbuild scripts/simtest.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/hoops/simtest.cjs && node node_modules/.cache/hoops/simtest.cjs 10"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.1.0",
    "@fontsource/teko": "^5.1.0",
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
